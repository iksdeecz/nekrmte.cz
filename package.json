{
  "name": "nekrmte.cz",
  "version": "1.0.0",
  "description": "Statický web pro rychlou orientaci při požití potraviny psem nebo kočkou.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/build.mjs --check",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20"
  }
}
